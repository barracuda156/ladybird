import("//Meta/gn/build/libs/ffmpeg/enable.gni")

declare_args() {
  # Select whether to look for ffmpeg in ports
  ffmpeg_ports = current_os == "mac"

  # Root directory for ports installation
  ports_prefix = "/opt/local"
}

declare_args() {
  ffmpeg_prefix = "/usr"
  if (ffmpeg_ports) {
    ffmpeg_prefix = "${ports_prefix}"
  }
}

# FIXME: We don't build this, we pull it from the user's system
# So it doesn't follow the usual third_party_dependency pattern
config("ffmpeg_config") {
  visibility = [ ":ffmpeg" ]
  include_dirs = [ "${ffmpeg_prefix}/include" ]
  lib_dirs = [ "${ffmpeg_prefix}/lib" ]
  libs = [
    "avcodec",
    "avformat",
    "avutil",
    "swresample",
  ]
}

group("ffmpeg") {
  if (enable_ffmpeg) {
    public_configs = [ ":ffmpeg_config" ]
  }
}
